syntax on

filetype plugin indent on

" tabs
set expandtab
set shiftwidth=4
set softtabstop=4
set tabstop=4 
set smartindent

" highlighted search
set relativenumber
set ignorecase
set smartcase
set hlsearch
set incsearch

set wrap 
set linebreak
set noswapfile
set viminfo+='1000,n~/.config/vim/viminfo
